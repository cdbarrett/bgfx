load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "glslang",
    srcs = glob(
        [
            "glslang/**/*.cpp",
            "SPIRV/**/*.cpp",
        ],
        exclude = ["glslang/OSDependent/Windows/**"],
    ),
    hdrs = ["build_info.h"] + glob([
        "glslang/**/*.h",
        "SPIRV/**/*.h",
        "SPIRV/**/*.hpp11",
        "StandAlone/*.h",
    ]),
    copts = [
        "-fno-strict-aliasing",
        "-Wno-ignored-qualifiers",
        "-Wno-implicit-fallthrough",
        "-Wno-missing-field-initializers",
        "-Wno-reorder",
        "-Wno-return-type",
        "-Wno-shadow",
        "-Wno-sign-compare",
        "-Wno-switch",
        "-Wno-undef",
        "-Wno-unknown-pragmas",
        "-Wno-unused-function",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
    ],
    defines = [
        "ENABLE_OPT=1",
        "ENABLE_HLSL=1",
    ],
    includes = [
        "glslang/Include",
        "glslang/Public",
    ],
    strip_include_prefix = ".",
    visibility = ["//:__subpackages__"],
    deps = ["//3rdparty/spirv-tools"],
)
