load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "glsl-optimizer",
    srcs = glob(
        [
            "src/glsl/*.cpp",
            "src/glsl/*.h",
            "src/glsl/glcpp/*.c",
            "src/glsl/glcpp/*.h",
            "src/mesa/**/*.h",
            "src/util/*.h",
            "include/*.h",
        ],
        exclude = ["src/glsl/main.cpp"],
    ) + [
        "src/glsl/strtod.c",
        "src/mesa/main/imports.c",
        "src/mesa/program/prog_hash_table.c",
        "src/mesa/program/symbol_table.c",
        "src/util/hash_table.c",
        "src/util/ralloc.c",
    ],
    hdrs = ["src/glsl/glsl_optimizer.h"],
    copts = [
        "-I3rdparty/glsl-optimizer/include",
        "-I3rdparty/glsl-optimizer/src",
        "-I3rdparty/glsl-optimizer/src/mesa",
        "-I3rdparty/glsl-optimizer/src/glsl",
        "-fno-strict-aliasing",
        "-Wno-implicit-fallthrough",
        "-Wno-parentheses",
        "-Wno-sign-compare",
        "-Wno-unused-function",
        "-Wno-unused-parameter",
    ],
    strip_include_prefix = "src/glsl",
    visibility = ["//:__subpackages__"],
)
