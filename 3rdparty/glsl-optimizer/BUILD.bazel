load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "includes",
    hdrs = glob([
        "include/**/*.h",
    ]),
    strip_include_prefix = "include",
)

cc_library(
    name = "mesa",
    srcs = glob([
        "src/mesa/**/*.c",
    ]),
    hdrs = glob([
        "src/mesa/**/*.h",
    ]),
    strip_include_prefix = "src/mesa",
    deps = [
        ":includes",
        ":util",
    ],
)

cc_library(
    name = "util",
    srcs = glob([
        "src/util/*.c",
    ]),
    hdrs = glob([
        "src/util/*.h",
    ]),
    strip_include_prefix = "src",
    deps = [
        ":includes",
    ],
)

cc_library(
    name = "glsl",
    srcs = glob(
        [
            "src/glsl/**/*.cpp",
            "src/glsl/**/*.c",
        ],
        exclude = ["src/glsl/main.cpp"],
    ),
    hdrs = glob([
        "src/glsl/*.h",
        "src/glsl/glcpp/*.h",
    ]),
    strip_include_prefix = "src/glsl",
    deps = [
        ":includes",
        ":mesa",
        ":util",
    ],
)

cc_library(
    name = "glsl-optimizer",
    visibility = ["//:__subpackages__"],
    deps = [
        ":glsl",
        ":includes",
        ":mesa",
        ":util",
    ],
)
