load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "private_headers",
    hdrs = glob(["source/**/*.h"]),
    strip_include_prefix = ".",
)

cc_library(
    name = "generated_headers",
    hdrs = glob(["include/generated/*.h"]),
    strip_include_prefix = "include/generated",
    textual_hdrs = glob(["include/generated/*.inc"]),
)

cc_library(
    name = "spirv-tools",
    srcs = glob([
        "source/opt/*.cpp",
        "source/reduce/*.cpp",
        "source/val/*.cpp",
    ]) + [
        "source/assembly_grammar.cpp",
        "source/binary.cpp",
        "source/diagnostic.cpp",
        "source/disassemble.cpp",
        "source/ext_inst.cpp",
        "source/extensions.cpp",
        "source/libspirv.cpp",
        "source/name_mapper.cpp",
        "source/opcode.cpp",
        "source/operand.cpp",
        "source/parsed_operand.cpp",
        "source/print.cpp",
        "source/software_version.cpp",
        "source/spirv_endian.cpp",
        "source/spirv_optimizer_options.cpp",
        "source/spirv_reducer_options.cpp",
        "source/spirv_target_env.cpp",
        "source/spirv_validator_options.cpp",
        "source/table.cpp",
        "source/table2.cpp",
        "source/text.cpp",
        "source/text_handler.cpp",
        "source/to_string.cpp",
        "source/util/bit_vector.cpp",
        "source/util/parse_number.cpp",
        "source/util/string_utils.cpp",
    ],
    hdrs = glob([
        "include/spirv-tools/*.h",
        "include/spirv-tools/*.hpp",
    ]),
    strip_include_prefix = "include",
    deps = [
        ":generated_headers",
        ":private_headers",
        "//3rdparty/spirv-headers",
    ],
    visibility = ["//:__subpackages__"],
)

cc_library(
    name = "spirv-tools-internal",
    visibility = ["//:__subpackages__"],
    deps = [
        ":generated_headers",
        ":private_headers",
        "//3rdparty/spirv-headers",
    ],
)
